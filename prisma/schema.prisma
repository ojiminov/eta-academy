generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum StudentStatus {
  LEAD
  TRIAL
  ACTIVE
  GRADUATE
  INACTIVE
}

enum EnglishLevel {
  BEGINNER
  ELEMENTARY
  PRE_INTERMEDIATE
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HOLIDAY
  HW_NOT_DONE
}

enum MarketingSource {
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  REFERRAL
  WALK_IN
  WEBSITE
  OTHER
}

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  MARKETING
  SUPPLIES
  EQUIPMENT
  OTHER
}

enum HomeworkStatus {
  ASSIGNED
  SUBMITTED
  GRADED
  LATE
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum CoinType {
  ATTENDANCE
  HOMEWORK
  EXAM
  STREAK
  BONUS
}

enum NotificationType {
  INFO
  WARNING
  PAYMENT
  ATTENDANCE
  HOMEWORK
  EXAM
}

// ─── CORE USERS ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher          Teacher?
  student          Student?
  parent           Parent?
  notifications    Notification[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")

  @@map("users")
}

// ─── TEACHER ─────────────────────────────────────────────────────────────────

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  subjects  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups          Group[]
  classSessions   ClassSession[]
  homeworks       Homework[]
  exams           Exam[]
  courseMaterials CourseMaterial[]

  @@map("teachers")
}

// ─── STUDENT ─────────────────────────────────────────────────────────────────

model Student {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          StudentStatus   @default(ACTIVE)
  dateOfBirth     DateTime?
  englishLevel    EnglishLevel    @default(BEGINNER)
  parentName      String?
  parentPhone     String?
  notes           String?
  balance         Float           @default(0)
  discountPercent Float           @default(0)
  pinfl           String?
  contractNumber  String?
  marketingSource MarketingSource?
  enrollmentDate  DateTime?
  totalCoins      Int             @default(0)
  currentStreak   Int             @default(0)
  longestStreak   Int             @default(0)
  badge           BadgeTier       @default(BRONZE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  groupStudents   GroupStudent[]
  payments        Payment[]
  grades          Grade[]
  attendances     Attendance[]
  homeworkGrades  HomeworkGrade[]
  examResults     ExamResult[]
  documents       StudentDocument[]
  parent          Parent?
  coinTransactions CoinTransaction[]

  @@map("students")
}

// ─── PARENT ──────────────────────────────────────────────────────────────────

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
}

// ─── LEAD (SALES FUNNEL) ─────────────────────────────────────────────────────

model Lead {
  id                   String           @id @default(cuid())
  firstName            String
  lastName             String
  phone                String
  email                String?
  source               MarketingSource  @default(OTHER)
  status               StudentStatus    @default(LEAD)
  interestedLevel      EnglishLevel?
  trialDate            DateTime?
  notes                String?
  convertedToStudentId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("leads")
}

// ─── GROUP ───────────────────────────────────────────────────────────────────

model Group {
  id          String       @id @default(cuid())
  name        String
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  level       EnglishLevel
  schedule    String
  room        String?
  maxStudents Int          @default(12)
  isActive    Boolean      @default(true)
  startDate   DateTime
  endDate     DateTime?
  monthlyFee  Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  groupStudents   GroupStudent[]
  classSessions   ClassSession[]
  invoices        Invoice[]
  homeworks       Homework[]
  exams           Exam[]
  courseMaterials CourseMaterial[]

  @@map("groups")
}

model GroupStudent {
  id        String   @id @default(cuid())
  groupId   String
  studentId String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)

  @@unique([groupId, studentId])
    @@index([groupId])
  @@index([studentId])
  @@map("group_students")
}

// ─── CLASS SESSIONS & ATTENDANCE ─────────────────────────────────────────────

model ClassSession {
  id          String   @id @default(cuid())
  groupId     String
  teacherId   String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  scheduledAt DateTime
  duration    Int      @default(90)
  topic       String?
  notes       String?
  room        String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendances Attendance[]
  grades      Grade[]

  @@map("class_sessions")
}

model Attendance {
  id             String           @id @default(cuid())
  classSessionId String
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus @default(ABSENT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([classSessionId, studentId])
    @@index([classSessionId])
  @@index([studentId])
  @@map("attendances")
}

// ─── GRADES ──────────────────────────────────────────────────────────────────

model Grade {
  id             String        @id @default(cuid())
  studentId      String
  classSessionId String?
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id])
  score          Float
  maxScore       Float         @default(100)
  label          String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("grades")
}

// ─── HOMEWORK ────────────────────────────────────────────────────────────────

model Homework {
  id          String    @id @default(cuid())
  groupId     String
  teacherId   String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  title       String
  description String?
  dueDate     DateTime
  returnDate  DateTime?
  maxScore    Float     @default(100)
  fileUrl     String?   // teacher-uploaded assignment file
  fileName    String?
  fileSize    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  grades HomeworkGrade[]

  @@map("homeworks")
}

model HomeworkGrade {
  id          String         @id @default(cuid())
  homeworkId  String
  studentId   String
  homework    Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         HomeworkStatus @default(ASSIGNED)
  score          Float?
  feedback       String?
  submittedAt    DateTime?
  gradedAt       DateTime?
  submissionUrl  String?   // student-uploaded file
  submissionName String?
  submissionSize Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([homeworkId, studentId])
    @@index([homeworkId])
  @@index([studentId])
  @@map("homework_grades")
}

// ─── EXAMS ───────────────────────────────────────────────────────────────────

model Exam {
  id          String   @id @default(cuid())
  groupId     String
  teacherId   String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  title       String
  description String?
  scheduledAt DateTime
  duration    Int?
  maxScore    Float    @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  results ExamResult[]

  @@map("exams")
}

model ExamResult {
  id        String    @id @default(cuid())
  examId    String
  studentId String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Float?
  feedback  String?
  gradedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([examId, studentId])
    @@index([examId])
  @@index([studentId])
  @@map("exam_results")
}

// ─── PAYMENTS & INVOICES ─────────────────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  amount    Float
  currency  String        @default("UZS")
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  method    String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("payments")
}

model Invoice {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  month     Int
  year      Int
  amount    Float
  currency  String   @default("UZS")
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([groupId, month, year])
  @@map("invoices")
}

// ─── EXPENSES ────────────────────────────────────────────────────────────────

model Expense {
  id          String          @id @default(cuid())
  title       String
  amount      Float
  currency    String          @default("UZS")
  category    ExpenseCategory @default(OTHER)
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("expenses")
}

// ─── ANNOUNCEMENTS ───────────────────────────────────────────────────────────

model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  targetRole Role?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("announcements")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

    @@index([userId])
  @@map("notifications")
}

// ─── CHAT MESSAGES ───────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("messages")
}

// ─── STUDENT DOCUMENTS ───────────────────────────────────────────────────────

model StudentDocument {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name       String
  url        String
  fileType   String?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("student_documents")
}

// ─── COURSE MATERIALS ─────────────────────────────────────────────────────────

model CourseMaterial {
  id          String   @id @default(cuid())
  groupId     String?
  teacherId   String
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  fileType    String?
  createdAt   DateTime @default(now())

  @@map("course_materials")
}

// ─── ACADEMY SETTINGS (branding) ─────────────────────────────────────────────

model AcademySetting {
  id           String   @id @default("singleton")
  name         String   @default("ETA Academy")
  logoUrl      String?
  logoName     String?
  primaryColor String   @default("#6366f1")
  updatedAt    DateTime @updatedAt

  @@map("academy_settings")
}

// ─── COIN TRANSACTIONS ────────────────────────────────────────────────────────

model CoinTransaction {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Int
  type      CoinType
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@map("coin_transactions")
}
